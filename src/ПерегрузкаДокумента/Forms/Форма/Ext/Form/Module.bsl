&НаКлиентеПроцедура ОбновитьВидимостьПросмотраФайла()	Элементы.ПросмотрФайла.Видимость = ЗначениеЗаполнено(Объект.Файл);КонецПроцедуры&НаКлиентеПроцедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)	СтандартнаяОбработка = Ложь;	ДиалоговоеОкно = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);	ДиалоговоеОкно.Заголовок = "Выберите нужный документ";	ДиалоговоеОкно.Фильтр = "Текстовый документ(*.txt)|*.txt|Табличный документ(*.mxl)|*.mxl";	ДиалоговоеОкно.ПроверятьСуществованиеФайла = Ложь;	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);	ДиалоговоеОкно.Показать(Оповещение);КонецПроцедуры&НаКлиентеПроцедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда		Объект.Файл = ВыбранныеФайлы[0];	КонецЕсли;	ОбновитьВидимостьПросмотраФайла();КонецПроцедуры&НаКлиентеПроцедура ФайлПриИзменении(Элемент)	ОбновитьВидимостьПросмотраФайла();КонецПроцедуры&НаКлиентеПроцедура ПросмотрФайла(Команда)	ФайлНаДиске = Новый Файл(Объект.Файл);	Если НЕ ФайлНаДиске.Существует() Тогда		ПоказатьПредупреждение(, "Файл не найден. Вероятнее всего вы не выгрузили документ.");		Возврат;	КонецЕсли;	ЗапуститьПриложение(Объект.Файл);КонецПроцедуры&НаКлиентеПроцедура ВыгрузитьДокумент(Команда)	Если НЕ ЗначениеЗаполнено(Объект.Документ) ИЛИ НЕ ЗначениеЗаполнено(Объект.Файл) Тогда		ПоказатьПредупреждение(, "Не заполнено одно или несколько полей");		Возврат;	КонецЕсли;	ТекстДляФайла = СформироватьТекстДокументаНаСервере(Объект.Документ);	ТекстовыйДокумент = Новый ТекстовыйДокумент;	ТекстовыйДокумент.УстановитьТекст(ТекстДляФайла);	ТекстовыйДокумент.Записать(Объект.Файл);	ОбновитьВидимостьПросмотраФайла();	Сообщить("Выгрузка произведена успешно!");КонецПроцедуры&НаКлиентеПроцедура ЗагрузитьДокумент(Команда)	Если НЕ ЗначениеЗаполнено(Объект.Файл) Тогда		ПоказатьПредупреждение(, "Не заполнено поле 'Файл'");		Возврат;	КонецЕсли;	ФайлНаДиске = Новый Файл(Объект.Файл);	Если НЕ ФайлНаДиске.Существует() Тогда		ПоказатьПредупреждение(, "Файл не найден: " + Объект.Файл);		Возврат;	КонецЕсли;	ТекстовыйДокумент = Новый ТекстовыйДокумент;	ТекстовыйДокумент.Прочитать(Объект.Файл);	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();	Если НЕ ЗначениеЗаполнено(ТекстФайла) Тогда		ПоказатьПредупреждение(, "Выбранный файл пуст!");		Возврат;	КонецЕсли;	ОшибкаПроведения = СоздатьДокументИзТекстаНаСервере(ТекстФайла);	Если ЗначениеЗаполнено(ОшибкаПроведения) Тогда		ПоказатьПредупреждение(, "Документ загружен, но его не удалось провести по причине:"			+ Символы.ПС + ОшибкаПроведения);	Иначе		Сообщить("Документ успешно загружен");	КонецЕсли;КонецПроцедуры&НаСервереФункция ЭкранироватьСтрокуНаСервере(Знач Значение)	Возврат СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, ""), Символы.ПС, "<ПС>");КонецФункции&НаСервереФункция ЭтоСсылкаСКодомИНаименованием(Знач ВидОбъекта)	Возврат ВидОбъекта = "Справочник"		ИЛИ ВидОбъекта = "ПланВидовХарактеристик"		ИЛИ ВидОбъекта = "ПланСчетов"		ИЛИ ВидОбъекта = "ПланВидовРасчета";КонецФункции&НаСервереФункция МенеджерОбъектаНаСервере(Знач ВидОбъекта, Знач ИмяОбъекта)	Если ВидОбъекта = "Справочник" Тогда		Возврат Справочники[ИмяОбъекта];	ИначеЕсли ВидОбъекта = "ПланВидовХарактеристик" Тогда		Возврат ПланыВидовХарактеристик[ИмяОбъекта];	ИначеЕсли ВидОбъекта = "ПланСчетов" Тогда		Возврат ПланыСчетов[ИмяОбъекта];	ИначеЕсли ВидОбъекта = "ПланВидовРасчета" Тогда		Возврат ПланыВидовРасчета[ИмяОбъекта];	ИначеЕсли ВидОбъекта = "Документ" Тогда		Возврат Документы[ИмяОбъекта];	ИначеЕсли ВидОбъекта = "Перечисление" Тогда		Возврат Перечисления[ИмяОбъекта];	КонецЕсли;	Возврат Неопределено;КонецФункции&НаСервереФункция СериализоватьЗначениеНаСервере(Знач Значение)	ТипЗначения = ТипЗнч(Значение);	Если ТипЗначения = Тип("Строка") Тогда		Возврат "[Строка]" + ЭкранироватьСтрокуНаСервере(Значение);	ИначеЕсли ТипЗначения = Тип("Число") Тогда		Возврат "[Число]" + Формат(Значение, "ЧРД=.; ЧГ=");	ИначеЕсли ТипЗначения = Тип("Булево") Тогда		Возврат "[Булево]" + ?(Значение, "Да", "Нет");	ИначеЕсли ТипЗначения = Тип("Дата") Тогда		Возврат "[Дата]" + Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'");	КонецЕсли;	МетаОбъект = Метаданные.НайтиПоТипу(ТипЗначения);	Если МетаОбъект = Неопределено Тогда		Возврат "[Строка]" + ЭкранироватьСтрокуНаСервере(Строка(Значение));	КонецЕсли;	ЧастиПолногоИмени = СтрРазделить(МетаОбъект.ПолноеИмя(), ".");	ВидОбъекта = ЧастиПолногоИмени[0];	Если ЭтоСсылкаСКодомИНаименованием(ВидОбъекта) Тогда		Код          = ?(МетаОбъект.ДлинаКода > 0, СокрЛП(Значение.Код), "");		Наименование = ?(МетаОбъект.ДлинаНаименования > 0, Значение.Наименование, Строка(Значение));		Возврат "[" + ВидОбъекта + "." + МетаОбъект.Имя + "]{" + Код + "}"			+ ЭкранироватьСтрокуНаСервере(Наименование);	ИначеЕсли ВидОбъекта = "Документ" Тогда		Возврат "[Документ." + МетаОбъект.Имя + "]{"			+ СокрЛП(Значение.Номер) + "|"			+ Формат(Значение.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'") + "}"			+ Строка(Значение);	ИначеЕсли ВидОбъекта = "Перечисление" Тогда		Возврат "[Перечисление." + МетаОбъект.Имя + "]" + Строка(Значение);	КонецЕсли;	Возврат "[Строка]" + ЭкранироватьСтрокуНаСервере(Строка(Значение));КонецФункции&НаСервереФункция ПрочитатьЗначениеИзСтрокиНаСервере(Знач ЗначениеСтрокой)	Если Лев(ЗначениеСтрокой, 1) <> "[" Тогда		Возврат ЗначениеСтрокой;	КонецЕсли;	ПозицияЗакрытия = СтрНайти(ЗначениеСтрокой, "]");	ИмяТипа = Сред(ЗначениеСтрокой, 2, ПозицияЗакрытия - 2);	Тело    = Сред(ЗначениеСтрокой, ПозицияЗакрытия + 1);	Если ИмяТипа = "Строка" Тогда		Возврат СтрЗаменить(Тело, "<ПС>", Символы.ПС);	ИначеЕсли ИмяТипа = "Число" Тогда		Возврат Число(Тело);	ИначеЕсли ИмяТипа = "Булево" Тогда		Возврат (ВРег(Тело) = "ДА") ИЛИ (ВРег(Тело) = "ИСТИНА");	ИначеЕсли ИмяТипа = "Дата" Тогда		Возврат Дата(Тело);	КонецЕсли;	ЧастиИмени = СтрРазделить(ИмяТипа, ".");	Если ЧастиИмени.Количество() <> 2 Тогда		Возврат Неопределено;	КонецЕсли;	ВидОбъекта = ЧастиИмени[0];	ИмяОбъекта = ЧастиИмени[1];	Менеджер = МенеджерОбъектаНаСервере(ВидОбъекта, ИмяОбъекта);	Если Менеджер = Неопределено Тогда		Возврат Неопределено;	КонецЕсли;	Если ЭтоСсылкаСКодомИНаименованием(ВидОбъекта) Тогда		ПозицияСкобки = СтрНайти(Тело, "}");		Код          = Сред(Тело, 2, ПозицияСкобки - 2);		Наименование = СтрЗаменить(Сред(Тело, ПозицияСкобки + 1), "<ПС>", Символы.ПС);		НайденнаяСсылка = Менеджер.ПустаяСсылка();		Если ЗначениеЗаполнено(Код) Тогда			НайденнаяСсылка = Менеджер.НайтиПоКоду(Код);		КонецЕсли;		Если НЕ ЗначениеЗаполнено(НайденнаяСсылка) И ЗначениеЗаполнено(Наименование) Тогда			НайденнаяСсылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);		КонецЕсли;		Возврат НайденнаяСсылка;	ИначеЕсли ВидОбъекта = "Документ" Тогда		ПозицияСкобки = СтрНайти(Тело, "}");		КлючДокумента = Сред(Тело, 2, ПозицияСкобки - 2);		ЧастиКлюча = СтрРазделить(КлючДокумента, "|");		Возврат Менеджер.НайтиПоНомеру(ЧастиКлюча[0], Дата(ЧастиКлюча[1]));	ИначеЕсли ВидОбъекта = "Перечисление" Тогда		МетаПеречисление = Метаданные.Перечисления[ИмяОбъекта];		Для Каждого ТекЗначение Из МетаПеречисление.ЗначенияПеречисления Цикл			Если ТекЗначение.Синоним = Тело ИЛИ ТекЗначение.Имя = Тело Тогда				Возврат Перечисления[ИмяОбъекта][ТекЗначение.Имя];			КонецЕсли;		КонецЦикла;	КонецЕсли;	Возврат Неопределено;КонецФункции&НаСервереФункция ПолучитьКартуРеквизитовНаСервере(КоллекцияРеквизитов)	Карта = Новый Соответствие;	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл		Карта.Вставить(Реквизит.Синоним, Реквизит.Имя);	КонецЦикла;	Возврат Карта;КонецФункции&НаСервереФункция СформироватьТекстДокументаНаСервере(СсылкаНаДокумент)	МетаДокумента = СсылкаНаДокумент.Метаданные();	СтрокиФайла = Новый Массив;	СтрокиФайла.Добавить(МетаДокумента.Синоним		+ " № " + СсылкаНаДокумент.Номер		+ " от " + Формат(СсылкаНаДокумент.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'"));	СтрокиФайла.Добавить("Проведен: " + ?(СсылкаНаДокумент.Проведен, "Да", "Нет"));	Для Каждого Реквизит Из МетаДокумента.Реквизиты Цикл		ЗначениеПоля = СсылкаНаДокумент[Реквизит.Имя];		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда			СтрокиФайла.Добавить(Реквизит.Синоним + ": " + СериализоватьЗначениеНаСервере(ЗначениеПоля));		КонецЕсли;	КонецЦикла;	Для Каждого ТЧ Из МетаДокумента.ТабличныеЧасти Цикл		ТаблицаДокумента = СсылкаНаДокумент[ТЧ.Имя];		Если ТаблицаДокумента.Количество() = 0 Тогда			Продолжить;		КонецЕсли;		СтрокиФайла.Добавить("[ТабличнаяЧасть: " + ТЧ.Имя + "]");		Для Каждого СтрокаТЧ Из ТаблицаДокумента Цикл			СтрокиФайла.Добавить("[НоваяСтрока]");			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл				ЗначениеКолонки = СтрокаТЧ[РеквизитТЧ.Имя];				Если ЗначениеЗаполнено(ЗначениеКолонки) Тогда					СтрокиФайла.Добавить(РеквизитТЧ.Синоним + ": " + СериализоватьЗначениеНаСервере(ЗначениеКолонки));				КонецЕсли;			КонецЦикла;		КонецЦикла;		СтрокиФайла.Добавить("[КонецТабличнойЧасти]");	КонецЦикла;	Возврат СтрСоединить(СтрокиФайла, Символы.ПС);КонецФункции&НаСервереФункция СоздатьДокументИзТекстаНаСервере(Знач ТекстФайла)	МассивСтрок = СтрРазделить(ТекстФайла, Символы.ПС);	ПерваяСтрока = МассивСтрок[0];	ПозицияСимволаНомера = СтрНайти(ПерваяСтрока, " № ");	ПозицияСимволаОт     = СтрНайти(ПерваяСтрока, " от ", НаправлениеПоиска.СКонца);	СинонимДокумента = Лев(ПерваяСтрока, ПозицияСимволаНомера - 1);	СинонимДаты      = Сред(ПерваяСтрока, ПозицияСимволаОт + 4);	ИмяДокумента = "";	Для Каждого ТекДок Из Метаданные.Документы Цикл		Если СинонимДокумента = ТекДок.Синоним Тогда			ИмяДокумента = ТекДок.Имя;			Прервать;		КонецЕсли;	КонецЦикла;	Если ИмяДокумента = "" Тогда		ВызватьИсключение("Не удалось найти документ по синониму: " + СинонимДокумента);	КонецЕсли;	МетаДокумента = Метаданные.Документы[ИмяДокумента];	НовыйДокумент = Документы[ИмяДокумента].СоздатьДокумент();	НовыйДокумент.Дата = Дата(СокрЛП(СинонимДаты));	ДокументБылПроведен = Ложь;	КартаРеквизитовШапки = ПолучитьКартуРеквизитовНаСервере(МетаДокумента.Реквизиты);	КартаРеквизитовТЧ = Неопределено;	ИмяТекущейТЧ    = "";	ТекущаяСтрокаТЧ = Неопределено;	Для Индекс = 1 По МассивСтрок.ВГраница() Цикл		ТекущаяСтрока = СокрЛП(МассивСтрок[Индекс]);		Если Лев(ТекущаяСтрока, 16) = "[ТабличнаяЧасть:" Тогда			ИмяТекущейТЧ = СокрЛП(СтрЗаменить(Сред(ТекущаяСтрока, 17), "]", ""));			КартаРеквизитовТЧ = ПолучитьКартуРеквизитовНаСервере(МетаДокумента.ТабличныеЧасти[ИмяТекущейТЧ].Реквизиты);			Продолжить;		ИначеЕсли ТекущаяСтрока = "[НоваяСтрока]" Тогда			Если ЗначениеЗаполнено(ИмяТекущейТЧ) Тогда				ТекущаяСтрокаТЧ = НовыйДокумент[ИмяТекущейТЧ].Добавить();			КонецЕсли;			Продолжить;		ИначеЕсли ТекущаяСтрока = "[КонецТабличнойЧасти]" Тогда			ИмяТекущейТЧ      = "";			ТекущаяСтрокаТЧ   = Неопределено;			КартаРеквизитовТЧ = Неопределено;			Продолжить;		КонецЕсли;		ПозицияРазделителя = СтрНайти(ТекущаяСтрока, ": ");		Если ПозицияРазделителя = 0 Тогда			Продолжить;		КонецЕсли;		СинонимРеквизита = СокрЛП(Лев(ТекущаяСтрока, ПозицияРазделителя - 1));		ЗначениеСтрокой  = СокрЛП(Сред(ТекущаяСтрока, ПозицияРазделителя + 2));		Если СинонимРеквизита = "Проведен" Тогда			ДокументБылПроведен = (ВРег(ЗначениеСтрокой) = "ДА") ИЛИ (ВРег(ЗначениеСтрокой) = "ИСТИНА");			Продолжить;		КонецЕсли;		Если ЗначениеЗаполнено(ИмяТекущейТЧ) Тогда			Если ТекущаяСтрокаТЧ = Неопределено Тогда				Продолжить;			КонецЕсли;			ИмяРеквизита = КартаРеквизитовТЧ[СинонимРеквизита];			Если ИмяРеквизита <> Неопределено Тогда				ТекущаяСтрокаТЧ[ИмяРеквизита] = ПрочитатьЗначениеИзСтрокиНаСервере(ЗначениеСтрокой);			КонецЕсли;		Иначе			ИмяРеквизита = КартаРеквизитовШапки[СинонимРеквизита];			Если ИмяРеквизита <> Неопределено Тогда				НовыйДокумент[ИмяРеквизита] = ПрочитатьЗначениеИзСтрокиНаСервере(ЗначениеСтрокой);			КонецЕсли;		КонецЕсли;	КонецЦикла;	Если ДокументБылПроведен Тогда		Попытка			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);		Исключение			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);			Возврат ОписаниеОшибки();		КонецПопытки;	Иначе		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);	КонецЕсли;	Возврат "";КонецФункции